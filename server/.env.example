# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:8080

# Database
DATABASE_URL=postgres://ems:ems@localhost:5432/smart_ems
PGSSL=false

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Logging
LOG_LEVEL=info
