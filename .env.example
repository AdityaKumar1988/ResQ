# ────────────────────────────────────────────────────────────
# Smart EMS — Frontend Environment Variables
# Copy this file to .env and fill in values before running.
# ────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:4000/api

# Socket.IO server URL (no trailing slash)
VITE_SOCKET_URL=http://localhost:4000

# App display name
VITE_APP_NAME=Smart EMS

# Environment: "development" or "production"
# Controls dev logging, error verbosity, and debug tools
VITE_ENV=development

# MapTiler API Key (Optional)
# If provided, the dark theme uses high-contrast MapTiler Dataviz Dark raster tiles.
# If omitted, maps fall back to OpenStreetMap tiles with a calibrated dark-mode filter.
VITE_MAP_TILE_KEY=

# ────────────────────────────────────────────────────────────
# SECURITY NOTES
# ────────────────────────────────────────────────────────────
# ⚠️  NEVER commit .env to version control.
# ⚠️  In production, set VITE_ENV=production to silence dev logs.
# ⚠️  Use unique, high-entropy values for JWT_ACCESS_SECRET and
#     JWT_REFRESH_SECRET in the backend server/.env file.
#     The defaults ("dev-access-secret" / "dev-refresh-secret")
#     are INSECURE and must not be used in production.
# ⚠️  Set CORS_ORIGIN in server/.env to the exact production
#     frontend domain (e.g., https://your-app.com).
